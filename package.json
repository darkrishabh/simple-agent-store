{
  "name": "simpleagentstore",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A deterministic, user-owned object store for AI agents.",
  "license": "Apache-2.0",
  "author": "Rishabh Mehan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkrishabh/simple-agent-store.git"
  },
  "bugs": {
    "url": "https://github.com/darkrishabh/simple-agent-store/issues"
  },
  "homepage": "https://simpleagentstore.com",
  "keywords": [
    "agents",
    "mcp",
    "object-store",
    "sqlite"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "ci": "npm run check && npm test && npm run build && npm run validate:distribution && npm run docs:check && npm run site:check",
    "site:check": "node scripts/check-site.mjs",
    "dashboard": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/dashboard-server.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "mcp": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/mcp.ts",
    "mcp:http": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/mcp-http.ts",
    "test:docker": "node scripts/test-docker.mjs",
    "mcp:tunnel": "node --env-file-if-exists=.env.local scripts/run-tunnel.mjs",
    "release:check": "npm run ci && npm audit --audit-level=high && npm run pack:check",
    "pack:check": "node scripts/check-package.mjs",
    "seed": "tsx src/seed-and-test.ts",
    "test": "vitest run",
    "validate:distribution": "node scripts/validate-distribution.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
